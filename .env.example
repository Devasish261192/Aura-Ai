# ==========================================
# AURA AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API keys
# ==========================================

# Google Gemini API Key (Required for AI Executive Co-Pilot & CV Forge)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional: for ultra-low-latency Llama-3 inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Mistral API Key (Optional fallback)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# SerpAPI Key (Optional: for live Google Jobs scraping)
# Get your key at: https://serpapi.com/
SERP_API_KEY=your_serp_api_key_here

# Telegram MTProto API Credentials (Optional: for Telegram job network integration)
# Register your app at: https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=your_phone_with_country_code
TELEGRAM_GROUP=target_group_username

# LLM Extraction Key (Optional fallback if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
